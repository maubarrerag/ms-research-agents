# Pick ONE way to give the agents a model (see README "Choosing a model backend").

# 1. Claude API key (backend: anthropic)
ANTHROPIC_API_KEY=

# 2. Claude Pro/Max login (backend: claude_code): no key needed, run `claude` once and /login.
# MSAGENTS_BACKEND=claude_code

# 3. LiteLLM (backend: litellm): set the key for your provider, or none for local Ollama
# MSAGENTS_BACKEND=litellm
# MSAGENTS_MODEL=ollama_chat/qwen3:14b
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# MSAGENTS_DATA=./data
# MSAGENTS_SANDBOX_TIMEOUT=300
